# Haos 服务端
HAOS_HOST=127.0.0.1
HAOS_PORT=4600
# 从其他机器访问时改成可访问地址，例如 http://192.168.1.10:4600
HAOS_PUBLIC_URL=http://127.0.0.1:4600
HAOS_DATA_DIR=./data
HAOS_DEMO_PASSWORD=haos-demo
HAOS_INSTANCE_OFFLINE_SECONDS=90

# Agent（在 DSH 机器上使用）
# HAOS_BASE_URL=http://127.0.0.1:4600
# HAOS_ENROLLMENT_KEY=haos_enr_xxx
# HAOS_WORKSPACE=~/.haos/workspace
